[user]
	name = maximsan
	email = maximuzz@yandex.ru
	
[includeIf "gitdir:~/Projects/work/itrex/noom/"]
	path = ~/Projects/work/itrex/noom/.gitconfig

[core]
	editor = code --wait
	autocrlf = input
	hooksPath = ~/.git-hooks
[init]
	defaultBranch = main
	templateDir = ~/.git-template
[pull]
	rebase = false
[alias]
	mc = merge --continue
	co = checkout
	pf = push --force
	p = push
	c = commit
	ca = commit --amend
	s = status
	br = branch
	st = status
	l10 = log --pretty=oneline -10
	l = log --oneline
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lsha = rev-parse HEAD
	lc = log -1 HEAD
	skip = push -f --no-verify
[http]
	postBuffer = 524288000
[hook "strip-ai-attribution"]
	event = commit-msg
	command = \"$HOME/.git-hooks/strip-ai-attribution\"
[hook "branch-name-creating"]
	event = reference-transaction
	command = \"$HOME/.git-hooks/branch-name-rule\" creating
[hook "branch-name-pushing"]
	event = pre-push
	command = \"$HOME/.git-hooks/branch-name-rule\" pushing
