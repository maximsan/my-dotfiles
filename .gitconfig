[user]
	name = maximsan
	email = maximuzz@yandex.ru
	
[includeIf "gitdir:~/Projects/work/itrex/noom/"]
	path = ~/Projects/work/itrex/noom/.gitconfig

[core]
	editor = code --wait
	autocrlf = input
[init]
	defaultBranch = main
[pull]
	rebase = false
[alias]
	mc = merge --continue
	co = checkout
	pf = push --force
	p = push
	c = commit
	ca = commit --amend
	s = status
	br = branch
	st = status
	l10 = log --pretty=oneline -10
	l = log --oneline
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lsha = rev-parse HEAD
	lc = log -1 HEAD
	skip = push -f --no-verify
[http]
	postBuffer = 524288000
# Hooks for every repo. They need Git 2.54 or later. Without node or the script, git skips them and carries on.
[hook "strip-ai-attribution"]
	event = commit-msg
	command = test -f \"$HOME/.git-hooks/strip-ai-attribution.mjs\" && command -v node >/dev/null || exit 0 && exec node \"$HOME/.git-hooks/strip-ai-attribution.mjs\"
[hook "branch-name-creating"]
	event = reference-transaction
	# Git runs this up to three times per change. Only the run just before the change is saved, "prepared", checks the
# name. The other runs skip starting node.
	command = [ \"$1\" = prepared ] && test -f \"$HOME/.git-hooks/branch-name-rule.mjs\" && command -v node >/dev/null || exit 0 && exec node \"$HOME/.git-hooks/branch-name-rule.mjs\" creating
[hook "branch-name-pushing"]
	event = pre-push
	command = test -f \"$HOME/.git-hooks/branch-name-rule.mjs\" && command -v node >/dev/null || exit 0 && exec node \"$HOME/.git-hooks/branch-name-rule.mjs\" pushing
