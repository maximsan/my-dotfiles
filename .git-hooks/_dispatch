#!/bin/sh
# Global git hook dispatcher, installed via `git config --global core.hooksPath`.
#
# Goal: enforce a machine-wide rule that no commit is attributed to an AI agent,
# regardless of which tool (Claude Code, Cursor, Copilot, Codex, ...) created it,
# while still running each repository's OWN hooks. This one script is symlinked to
# the common hook names, so a repo's own copy of any other hook does not run. For
# each linked hook it first runs the repo's hook of the same name. For `commit-msg`
# it then removes AI credit lines from the message.
#
# If a repo's own hook is a link to or a copy of this script, the script would
# call itself forever. Two checks stop that:
#   1. an exported variable recording the running hooks, which also catches copies;
#   2. a comparison of real file paths, which catches links.

hook_name="$(basename "$0")"

# --- Check 1: is this hook already running? ------------------------------------
# The colons stop one hook name matching inside a longer one.
already_active=
case ":${GIT_DISPATCH_ACTIVE:-}:" in
  *":$hook_name:"*) already_active=1 ;;
esac
GIT_DISPATCH_ACTIVE="${GIT_DISPATCH_ACTIVE:-}:$hook_name"
export GIT_DISPATCH_ACTIVE

# Locate the repository-local hook in the REAL git dir, never core.hooksPath.
# --git-common-dir keeps linked worktrees pointing at the shared hooks dir;
# fall back to --git-dir on older git.
git_dir="$(git rev-parse --git-common-dir 2>/dev/null || git rev-parse --git-dir 2>/dev/null)"
[ -n "$git_dir" ] || git_dir=".git"
local_hook="$git_dir/hooks/$hook_name"

# --- Check 2: is the repo's hook really this file? -----------------------------
# Resolve symlinks (runs in a subshell via command substitution, so the `cd`
# never affects the caller's working directory).
canonical() {
  cp=$1; n=0
  while [ -L "$cp" ] && [ "$n" -lt 40 ]; do
    d=$(dirname "$cp"); t=$(readlink "$cp")
    case "$t" in
      /*) cp=$t ;;
      *)  cp="$d/$t" ;;
    esac
    n=$((n + 1))
  done
  d=$(cd "$(dirname "$cp")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$d" "$(basename "$cp")"
}
self_real=$(canonical "$0" 2>/dev/null)
local_real=$(canonical "$local_hook" 2>/dev/null)

# Run the repo's own hook first, if it exists, is executable, and is another file.
if [ -z "$already_active" ] && [ -x "$local_hook" ] \
   && [ -n "$local_real" ] && [ "$local_real" != "$self_real" ]; then
  "$local_hook" "$@" || exit $?
fi

# --- commit-msg only: strip AI attribution ------------------------------------
[ "$hook_name" = "commit-msg" ] || exit 0
exec "$(dirname "$self_real")/strip-ai-attribution" "$@"
