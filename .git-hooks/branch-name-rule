#!/bin/sh
# Enforces branch names in maximsan's GitHub repos: <type>/<lowercase-with-dashes>,
# such as fix/login-retry.
# Git runs it for every repo through hook.* entries in the global config, so a
# repo with its own core.hooksPath is covered too.
#   creating: reference-transaction, when any tool creates a local branch
#   pushing:  pre-push, when a new branch would reach GitHub
# `git branch -m` skips reference-transaction, so only the push check catches a rename.
# Other people's repos keep their own conventions, and a branch that already
# exists on GitHub can always be checked out.

BRANCH_TYPES='feat|fix|chore|docs|refactor|test|prototype|research'
OWNER_REPO_GLOB='*github.com[:/]maximsan/*'

is_conventional() {
  printf '%s\n' "$1" | grep -Eq "^($BRANCH_TYPES)/[a-z0-9]+([-.][a-z0-9]+)*\$"
}

# Git passes an all-zero id for a ref that doesn't exist.
creates_ref() {
  case "$1" in *[!0]*) return 1 ;; esac
  case "$2" in *[!0]*) return 0 ;; esac
  return 1
}

refuse() {
  echo "Branch name '$1' breaks the naming rule. Use a kebab-case name starting with one of: $BRANCH_TYPES, then a slash. Example: fix/login-retry." >&2
  exit 1
}

case "$1" in
  creating)
    [ "$2" = prepared ] || { cat >/dev/null; exit 0; }
    # shellcheck disable=SC2254
    case "$(git remote get-url origin 2>/dev/null)" in $OWNER_REPO_GLOB) ;; *) cat >/dev/null; exit 0 ;; esac
    while read -r old new ref; do
      case "$ref" in refs/heads/*) ;; *) continue ;; esac
      creates_ref "$old" "$new" || continue
      name=${ref#refs/heads/}
      case "$name" in
        # Claude Code names its worktree branches worktree-*. They can be created here but not pushed.
        main|master|worktree-*) continue ;;
      esac
      is_conventional "$name" && continue
      git show-ref --verify --quiet "refs/remotes/origin/$name" </dev/null && continue
      refuse "$name"
    done
    ;;
  pushing)
    # shellcheck disable=SC2254
    case "$3" in $OWNER_REPO_GLOB) ;; *) cat >/dev/null; exit 0 ;; esac
    while read -r _local_ref local_oid remote_ref remote_oid; do
      case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
      creates_ref "$remote_oid" "$local_oid" || continue
      name=${remote_ref#refs/heads/}
      case "$name" in main|master) continue ;; esac
      is_conventional "$name" || refuse "$name"
    done
    ;;
esac
exit 0
